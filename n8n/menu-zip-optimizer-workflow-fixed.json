      "typeVersion": 1,
      "position": [
        430,
        280
      ]
    },
    {
      "parameters": {
        "command": "python3 /data/scripts/optimize_menu_zip.py /tmp/menu-input-{{$execution.id}}.zip /tmp/menu-output-{{$execution.id}}.zip /tmp/menu-report-{{$execution.id}}.json"
