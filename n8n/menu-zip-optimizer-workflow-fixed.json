      "typeVersion": 1,
      "position": [
        660,
        280
      ]
    },
    {
      "parameters": {
        "filePath": "=/tmp/menu-output-{{$execution.id}}.zip"
      },
      "id": "f817d718-05ac-4f0b-9575-0a6dc15b9443",
      "name": "Read Optimized ZIP",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        890,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
