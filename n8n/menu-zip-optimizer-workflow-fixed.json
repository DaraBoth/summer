    "Optimize ZIP": {
      "main": [
        [
          {
            "node": "Read Optimized ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Optimized ZIP": {
      "main": [
        [
          {
            "node": "Upload To Menu API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload To Menu API": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
