{
  "name": "Menu ZIP Optimizer + Deployer",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "menu-optimizer",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "fileName": "=/tmp/menu-input-{{$execution.id}}.zip",
        "dataPropertyName": "zipFile"
      },
      "id": "2",
      "name": "Write Input ZIP",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "command": "python3 /data/scripts/optimize_menu_zip.py /tmp/menu-input-{{$execution.id}}.zip /tmp/menu-output-{{$execution.id}}.zip /tmp/menu-report-{{$execution.id}}.json"
      },
      "id": "3",
      "name": "Optimize ZIP",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "filePath": "=/tmp/menu-output-{{$execution.id}}.zip"
      },
      "id": "4",
      "name": "Read Optimized ZIP",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://oldsummer.vercel.app/api/menu-zip",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "zipFile",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "5",
      "name": "Upload To Menu API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      },
      "id": "6",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1420,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Write Input ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write Input ZIP": {
      "main": [
        [
          {
            "node": "Optimize ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Optimize ZIP": {
      "main": [
        [
          {
            "node": "Read Optimized ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Optimized ZIP": {
      "main": [
        [
          {
            "node": "Upload To Menu API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload To Menu API": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
